{
  "manifest_version": 3,
  "name": "AskShree — 1-Click AI Sourcing Copilot",
  "version": "1.2.0",
  "description": "Autonomous candidate sourcing, skill extraction, and ATS pipeline ingestion for AskShree from LinkedIn and GitHub.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.askshree.com/*",
    "http://localhost:3000/*",
    "https://*.linkedin.com/*",
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Source Candidate with AskShree"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*",
        "https://*.linkedin.com/talent/*",
        "https://*.linkedin.com/sales/*",
        "https://github.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
